# Copy to .env and fill in. Never commit .env.
# Only needed for the providers you enable in config/llm.yaml.
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# live | record | replay  (record = use the cache, call the model on a miss and store the answer)
BRIEFER_LLM_MODE=record

# Set to 1 to stop all autonomous runs (kill switch condition 5).
BRIEFER_DISABLED=0

# Optional passphrase for the local review UI.
BRIEFER_UI_PASSPHRASE=
